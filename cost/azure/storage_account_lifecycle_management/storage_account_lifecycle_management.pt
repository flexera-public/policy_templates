script "js_blob_metrics_request", type: "javascript" do
  parameters "storage_accounts", "param_azure_endpoint", "param_cool_after_days", "metric_group"
  result "request"
  code <<-'EOS'
  // Slow down rate of requests to prevent throttling
  api_wait = 1
  var now = new Date().getTime()
  while(new Date().getTime() < now + (api_wait * 1000)) { /* Do nothing */ }

  // Each group of metrics needs its own request because their aggregations, intervals, and filters differ
  var metric_groups = {
    capacity: {
      metricnames: "BlobCapacity,BlobCount",
      aggregation: "average",
      interval: "P1D",
      filter: "Tier eq 'Hot' and BlobType eq 'BlockBlob'"
    },
    ingress: {
      metricnames: "Ingress",
      aggregation: "total",
      interval: "FULL"
    },
    egress: {
      metricnames: "Egress",
      aggregation: "total",
      interval: "FULL",
      filter: "ApiName eq 'GetBlob'"
    }
  }

  var metric_group_settings = metric_groups[metric_group]

  // The window always covers at least the last param_cool_after_days full days
  var end_date = new Date()
  end_date.setUTCHours(23, 59, 59, 999)

  var start_date = new Date()
  start_date.setUTCDate(start_date.getUTCDate() - param_cool_after_days)
  start_date.setUTCHours(0, 0, 0, 0)

  var host_tld = param_azure_endpoint == "management.chinacloudapi.cn" ? "cn" : "com"

  var query_params = {
    "api-version": "2024-02-01",
    "starttime": start_date.toISOString(),
    "endtime": end_date.toISOString(),
    "interval": metric_group_settings['interval'],
    "metricnames": metric_group_settings['metricnames'],
    "metricnamespace": "Microsoft.Storage/storageAccounts/blobServices",
    "aggregation": metric_group_settings['aggregation']
  }

  if (metric_group_settings['filter']) { query_params['filter'] = metric_group_settings['filter'] }

  var request = {
    auth: "auth_azure",
    host: storage_accounts[0]['region'] + ".metrics.monitor.azure." + host_tld,
    verb: "POST",
    path: "subscriptions/" + storage_accounts[0]['subscriptionId'] + "/metrics:getBatch",
    query_params: query_params,
    headers: {
      "User-Agent": "RS Policies",
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      "resourceids": _.map(storage_accounts, function(account) { return account['id'] + "/blobServices/default" })
    }),
    ignore_status: [400, 403, 404]
  }
EOS
end

datasource "ds_storage_account_subscriptions" do
  run_script $js_storage_account_subscriptions, $ds_storage_accounts_no_policy
end

script "js_storage_account_subscriptions", type: "javascript" do
  parameters "ds_storage_accounts_no_policy"
  result "result"
  code <<-'EOS'
  var eligible_accounts = _.filter(ds_storage_accounts_no_policy, function(account) {
    return account['estimateEligible'] === true
  })

  result = _.compact(_.uniq(_.pluck(eligible_accounts, 'subscriptionId')))
EOS
end

datasource "ds_storage_account_costs" do
  iterate $ds_storage_account_subscriptions
  request do
    run_script $js_storage_account_costs, iter_item, $ds_top_level_bcs, rs_org_id, rs_optima_host
  end
  result do
    encoding "json"
    collect jmes_path(response, "rows[*]") do
      field "resourceID", jmes_path(col_item, "dimensions.resource_id")
      field "usageType", jmes_path(col_item, "dimensions.usage_type")
      field "cost", jmes_path(col_item, "metrics.cost_amortized_unblended_adj")
    end
  end
end

script "js_storage_account_costs", type: "javascript" do
  parameters "subscriptionId", "ds_top_level_bcs", "rs_org_id", "rs_optima_host"
  result "request"
  code <<-'EOS'
  // The last 30 full days of cost data, ending 3 days ago to allow for the delay in billing data.
  // The end date is exclusive.
  var start_date = new Date()
  start_date.setUTCDate(start_date.getUTCDate() - 32)
  start_date = start_date.toISOString().split('T')[0]

  var end_date = new Date()
  end_date.setUTCDate(end_date.getUTCDate() - 2)
  end_date = end_date.toISOString().split('T')[0]

  var request = {
    auth: "auth_flexera",
    host: rs_optima_host,
    verb: "POST",
    path: "/bill-analysis/orgs/" + rs_org_id + "/costs/select",
    body_fields: {
      "dimensions": ["resource_id", "usage_type"],
      "granularity": "day",
      "start_at": start_date,
      "end_at": end_date,
      "metrics": ["cost_amortized_unblended_adj"],
      "billing_center_ids": ds_top_level_bcs,
      "limit": 100000,
      "filter": {
        "type": "and",
        "expressions": [
          {
            "type": "or",
            "expressions": [
              {
                "dimension": "service",
                "type": "equal",
                "value": "Microsoft.Storage"
              },
              {
                "dimension": "service",
                "type": "equal",
                "value": "microsoft.storage"
              }
            ]
          },
          {
            "dimension": "vendor_account",
            "type": "equal",
            "value": subscriptionId
          },
          {
            "type": "not",
            "expression": {
              "dimension": "adjustment_name",
              "type": "substring",
              "substring": "Shared"
            }
          }
        ]
      }
    },
    headers: {
      "User-Agent": "RS Policies",
      "Api-Version": "1.0"
    },
    ignore_status: [400]
  }
EOS
end

datasource "ds_hot_storage_costs" do
  run_script $js_hot_storage_costs, $ds_storage_account_costs
end

script "js_hot_storage_costs", type: "javascript" do
  parameters "ds_storage_account_costs"
  result "result"
  code <<-'EOS'
  // The cost of Hot tier "Data Stored" usage over the cost window for each Storage Account, keyed by lowercase resource ID.
  // Accounts with no matching cost data are left out entirely, so that they are not mistaken for accounts with no cost.
  // "Hot" must be a whole word so that usage types such as "Snapshot" are not mistaken for the Hot tier.
  var hot_regex = /(^|[^a-z])hot([^a-z]|$)/;

  result = {}

  _.each(ds_storage_account_costs, function(item) {
    var resource_id = typeof(item['resourceID']) == 'string' ? item['resourceID'].toLowerCase() : ''
    var usage_type = typeof(item['usageType']) == 'string' ? item['usageType'].toLowerCase() : ''

    if (resource_id == '' || usage_type.indexOf('data stored') == -1 || !hot_regex.test(usage_type)) { return }

    // Costs of anything nested under a Storage Account are counted towards that Storage Account
    var account_match = resource_id.match(/^(.*\/storageaccounts\/[^\/]+)/)
    var account_id = account_match ? account_match[1] : resource_id

    var cost = parseFloat(item['cost'])
    if (isNaN(cost)) { cost = 0 }

    result[account_id] = (result[account_id] || 0) + cost
  })
EOS
end

datasource "ds_pricing_regions" do
  run_script $js_pricing_regions, $ds_storage_accounts_no_policy
end

script "js_pricing_regions", type: "javascript" do
