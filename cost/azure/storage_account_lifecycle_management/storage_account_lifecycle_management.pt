datasource "ds_pricing" do
  iterate $ds_pricing_regions
  request do
    pagination $pagination_azure_pricing
    host "prices.azure.com"
    path "/api/retail/prices"
    query "currencyCode", val($ds_currency_code, "value")
    query "$filter", join(["serviceName eq 'Storage' and priceType eq 'Consumption' and armRegionName eq '", iter_item, "' and (productName eq 'General Block Blob v2' or productName eq 'Blob Storage')"])
    header "User-Agent", "RS Policies"
    ignore_status [400, 404]
  end
  result do
    encoding "json"
    collect jmes_path(response, "Items[*]") do
      field "region", jmes_path(col_item, "armRegionName")
      field "productName", jmes_path(col_item, "productName")
      field "skuName", jmes_path(col_item, "skuName")
      field "meterName", jmes_path(col_item, "meterName")
      field "unitOfMeasure", jmes_path(col_item, "unitOfMeasure")
      field "tierMinimumUnits", jmes_path(col_item, "tierMinimumUnits")
      field "retailPrice", jmes_path(col_item, "retailPrice")
      field "currencyCode", jmes_path(col_item, "currencyCode")
    end
  end
end

datasource "ds_pricing_lookup" do
  run_script $js_pricing_lookup, $ds_pricing
end

script "js_pricing_lookup", type: "javascript" do
  parameters "ds_pricing"
  result "result"
  code <<-'EOS'
  // The Hot and Cool block blob prices for each region, product, and redundancy, keyed by "region|product|redundancy".
  // Meters are matched on the SKU name, the end of the meter name, the unit of measure, and the first pricing tier
  // rather than on exact meter names, because the meter names are not consistent between redundancy levels.
  // The prices are for the first pricing tier, since that is the one that applies to the first 50 TB of data.
  var redundancies = ["LRS", "GRS", "RA-GRS", "ZRS", "GZRS", "RA-GZRS"]
  var product_names = ["General Block Blob v2", "Blob Storage"]

  // Some meters of the read-access redundancies are published under their non-read-access counterparts
  var fallback_redundancies = { "RA-GRS": "GRS", "RA-GZRS": "GZRS" }

  var lower = function(value) { return typeof(value) == 'string' ? value.toLowerCase().trim() : '' }

  var items = _.map(ds_pricing, function(item, index) {
    return {
      index: index,
      group: [lower(item['region']), lower(item['productName'])].join('|'),
      sku: lower(item['skuName']),
      meter: lower(item['meterName']),
      unit: lower(item['unitOfMeasure']),
      tier: parseFloat(item['tierMinimumUnits']),
      price: parseFloat(item['retailPrice']),
      meterName: item['meterName'],
      skuName: item['skuName']
    }
  })

  var items_by_group = _.groupBy(items, function(item) { return item['group'] })

  var findMeter = function(candidates, sku, meter_suffix, unit) {
    var match = _.find(candidates, function(item) {
      return item['sku'] == sku &&
        item['unit'] == unit &&
        item['tier'] === 0 &&
        !isNaN(item['price']) &&
        item['meter'].slice(-meter_suffix.length) == meter_suffix &&
        item['meter'].indexOf('iterative') == -1
    })

    if (match == undefined) { return null }

    return { price: match['price'], meterName: match['meterName'], skuName: match['skuName'], index: match['index'] }
  }

  result = {}

  _.each(_.uniq(_.map(ds_pricing, function(item) { return lower(item['region']) })), function(region) {
    _.each(product_names, function(product_name) {
      var candidates = items_by_group[[region, lower(product_name)].join('|')] || []

      _.each(redundancies, function(redundancy) {
        var hot_sku = "hot " + redundancy.toLowerCase()
        var cool_sku = "cool " + redundancy.toLowerCase()
        var cool_fallback_sku = fallback_redundancies[redundancy] ? "cool " + fallback_redundancies[redundancy].toLowerCase() : cool_sku

        result[[region, product_name, redundancy].join('|')] = {
          productName: product_name,
          redundancy: redundancy,
          hot: findMeter(candidates, hot_sku, "data stored", "1 gb/month"),
          cool: findMeter(candidates, cool_sku, "data stored", "1 gb/month"),
          coolWrite: findMeter(candidates, cool_sku, "write operations", "10k") || findMeter(candidates, cool_fallback_sku, "write operations", "10k"),
          coolRetrieval: findMeter(candidates, cool_sku, "data retrieval", "1 gb") || findMeter(candidates, cool_fallback_sku, "data retrieval", "1 gb")
        }
      })
    })
  })
EOS
end

# Not used by the policy itself. Retrieve this datasource to verify which Azure retail price meters were matched:
# fpt retrieve_data storage_account_lifecycle_management.pt --names ds_pricing_debug
datasource "ds_pricing_debug" do
  run_script $js_pricing_debug, $ds_pricing, $ds_pricing_lookup
end

script "js_pricing_debug", type: "javascript" do
  parameters "ds_pricing", "ds_pricing_lookup"
  result "result"
  code <<-'EOS'
  // The raw retail price items, each labeled with the price(s) it was matched as (if any)
  var slots = ["hot", "cool", "coolWrite", "coolRetrieval"]
  var matched = {}

  _.each(ds_pricing_lookup, function(entry) {
    _.each(slots, function(slot) {
      if (entry && entry[slot]) {
        var index = entry[slot]['index']
        if (matched[index] == undefined) { matched[index] = [] }
        matched[index].push(slot + ":" + entry['redundancy'])
      }
    })
  })

  result = _.map(ds_pricing, function(item, index) {
    return {
      region: item['region'],
      productName: item['productName'],
      skuName: item['skuName'],
      meterName: item['meterName'],
      unitOfMeasure: item['unitOfMeasure'],
      tierMinimumUnits: item['tierMinimumUnits'],
      retailPrice: item['retailPrice'],
      currencyCode: item['currencyCode'],
      matchedAs: (matched[index] || []).join(', ')
    }
  })
EOS
end

datasource "ds_merged_metrics" do
  run_script $js_merged_metrics, $ds_storage_accounts_no_policy, $ds_blob_capacity_metrics, $ds_blob_ingress_metrics, $ds_blob_egress_metrics, $ds_hot_storage_costs, $ds_pricing_lookup, $ds_currency, $ds_applied_policy, $param_cool_after_days, $param_min_savings, $param_max_payback_months, $param_incident_csv
end

script "js_merged_metrics", type: "javascript" do
  parameters "ds_storage_accounts_no_policy", "ds_blob_capacity_metrics", "ds_blob_ingress_metrics", "ds_blob_egress_metrics", "ds_hot_storage_costs", "ds_pricing_lookup", "ds_currency", "ds_applied_policy", "param_cool_after_days", "param_min_savings", "param_max_payback_months", "param_incident_csv"
  result "result"
  code <<-'EOS'
  var csv_message = param_incident_csv == "false" ? "" : "Incident table CSV file has been attached to emails for this incident."
  var bytes_per_gb = 1024 * 1024 * 1024

  // Function for formatting currency numbers later
  function formatNumber(number, separator) {
    var formatted_number = "0"

    if (number) {
      formatted_number = (Math.round(number * 100) / 100).toString().split(".")[0]

      if (separator) {
        var withSeparator = ""

        for (var i = 0; i < formatted_number.length; i++) {
          if (i > 0 && (formatted_number.length - i) % 3 == 0) { withSeparator += separator }
          withSeparator += formatted_number[i]
        }

        formatted_number = withSeparator
      }

      var decimal = (Math.round(number * 100) / 100).toString().split(".")[1]
      if (decimal) { formatted_number += "." + decimal }
    }

    return formatted_number
  }

  // Rounds a number, and returns an empty string for anything that is not a finite number
  function round(value, decimals) {
    if (typeof(value) != 'number' || !isFinite(value)) { return "" }

    var factor = Math.pow(10, decimals)
    return Math.round(value * factor) / factor
  }

  // Reduces the getBatch responses for one metric to a single value per Storage Account, keyed by lowercase resource ID.
  // A metric that is not returned, or that returns an error, is left out, which means its value is unknown.
  // A metric that is returned without any datapoints has a status of "empty", which means there was no activity.
  // The value of a "last" metric is its most recent datapoint. The value of a "sum" metric is the total of its datapoints.
  function reduceMetric(responses, metric_name, datapoint_key, mode) {
    var metrics_by_account = {}

    _.each(responses, function(response) {
      if (!response || typeof(response['resourceID']) != 'string') { return }

      var account_id = response['resourceID'].toLowerCase().replace(/\/blobservices\/default$/, '')

      var metric = _.find(response['value'], function(item) {
        return item && item['name'] && String(item['name']['value']).toLowerCase() == metric_name.toLowerCase()
      })

      if (metric == undefined || (metric['errorCode'] && metric['errorCode'] != 'Success')) { return }

      var found = false
      var value = 0

      _.each(metric['timeseries'], function(series) {
        var latest_time = null
        var latest_value = null

        _.each(series['data'], function(point) {
          if (!point || typeof(point[datapoint_key]) != 'number') { return }

          found = true
          if (mode == "sum") { value += point[datapoint_key] }

          if (latest_time == null || String(point['timeStamp']) >= latest_time) {
            latest_time = String(point['timeStamp'])
            latest_value = point[datapoint_key]
          }
        })

        if (mode == "last" && latest_value != null) { value += latest_value }
      })

      metrics_by_account[account_id] = { status: found ? "value" : "empty", value: value }
    })

    return metrics_by_account
  }

  var capacity_by_account = reduceMetric(ds_blob_capacity_metrics, "BlobCapacity", "average", "last")
  var blob_count_by_account = reduceMetric(ds_blob_capacity_metrics, "BlobCount", "average", "last")
  var ingress_by_account = reduceMetric(ds_blob_ingress_metrics, "Ingress", "total", "sum")
  var egress_by_account = reduceMetric(ds_blob_egress_metrics, "Egress", "total", "sum")

  var price_labels = [
    { slot: "hot", label: "Hot Data Stored" },
    { slot: "cool", label: "Cool Data Stored" },
    { slot: "coolWrite", label: "Cool Write Operations" },
    { slot: "coolRetrieval", label: "Cool Data Retrieval" }
  ]

  var unavailable_note = "Required Azure Monitor metrics unavailable"

  // Estimates the monthly savings of a lifecycle rule that moves Hot block blobs to the Cool tier after param_cool_after_days days.
  //
  // The estimate is a conservative lower bound. No more than touched_gb of data can have been written or read during
  // the last param_cool_after_days days, where touched_gb is the Ingress plus the GetBlob Egress over that time. Everything
  // else in the Hot tier has been untouched for at least param_cool_after_days days, so a rule would have moved it to
  // Cool. Repeated reads of the same bytes only shrink the amount of data that was touched, which makes the cold fraction
  // a floor and not a guess.
  function estimateSavings(account) {
    var estimate = {
      computed: false,
      net_savings: 0,
      payback_months: Infinity,
      note: "",
      hot_gb: "",
      eligible_gb: "",
      cold_fraction_pct: "",
      transition_cost: ""
    }

    if (account['estimateEligible'] !== true) {
      estimate['note'] = account['estimateNote']
      return estimate
    }

    var account_id = account['id'].toLowerCase()

    // Missing metrics are unknown, and are not treated as zero
    if (capacity_by_account[account_id] == undefined) {
      estimate['note'] = unavailable_note
      return estimate
    }

    var hot_bytes = capacity_by_account[account_id]['value']
    var hot_gb = hot_bytes / bytes_per_gb
    estimate['hot_gb'] = hot_gb

    if (!(hot_bytes > 0)) {
      estimate['note'] = "No Hot block blob data"
      return estimate
    }

    // Ingress and Egress that are returned without any datapoints mean that there was no traffic, which is what an idle account looks like
    var blob_count = blob_count_by_account[account_id]
    var ingress = ingress_by_account[account_id]
    var egress = egress_by_account[account_id]

    if (blob_count == undefined || blob_count['status'] != "value" || ingress == undefined || egress == undefined) {
      estimate['note'] = unavailable_note
      return estimate
    }

    var read_bytes = egress['value']
    var touched_gb = (ingress['value'] + read_bytes) / bytes_per_gb
    var cold_fraction = Math.min(Math.max(1 - touched_gb / hot_gb, 0), 1)
    var eligible_gb = hot_gb * cold_fraction
    var eligible_blobs = blob_count['value'] * cold_fraction

    estimate['eligible_gb'] = eligible_gb
    estimate['cold_fraction_pct'] = cold_fraction * 100

    var prices = ds_pricing_lookup[[String(account['region']).toLowerCase(), account['productName'], account['redundancy']].join('|')]

    var missing_prices = _.filter(price_labels, function(item) {
      var price = prices ? prices[item['slot']] : null
      return !price || (item['slot'] == "hot" && !(price['price'] > 0))
    })

    if (missing_prices.length > 0) {
      estimate['note'] = "Azure retail prices not found: " + _.pluck(missing_prices, 'label').join(', ')
      return estimate
    }

    var notes = []
    var retail_hot_rate = prices['hot']['price']
    var effective_hot_rate = retail_hot_rate
    var discount_ratio = 1

    // Use the effective Hot rate from the bill when there is one, so that discounts are taken into account
    var billed_hot_cost = ds_hot_storage_costs[account_id]

    if (billed_hot_cost == undefined) {
      notes.push("Billing data not found, so the Azure retail Hot rate was used")
    } else {
      effective_hot_rate = Math.max(billed_hot_cost, 0) / hot_gb
      discount_ratio = effective_hot_rate / retail_hot_rate
    }

    if (!(effective_hot_rate > 0)) {
      estimate['note'] = "No Hot storage cost found in billing data"
      return estimate
    }

    var cool_rate = prices['cool']['price'] * discount_ratio
    var gross_monthly = eligible_gb * (effective_hot_rate - cool_rate)

    // Conservative: assumes that all of the reads seen during the window would be reads of Cool data
    var retrieval_monthly = (read_bytes / bytes_per_gb) * prices['coolRetrieval']['price'] * (30 / param_cool_after_days)
    var net_monthly = gross_monthly - retrieval_monthly
    var transition_cost = (eligible_blobs / 10000) * prices['coolWrite']['price'] * discount_ratio

    estimate['computed'] = true
    estimate['net_savings'] = net_monthly
    estimate['transition_cost'] = transition_cost
    estimate['payback_months'] = net_monthly > 0 ? transition_cost / net_monthly : Infinity

    if (net_monthly <= 0 && eligible_gb <= 0) {
      notes.unshift("Metrics indicate that all Hot block blob data may have been written or read within the last " + param_cool_after_days + " days")
    } else if (net_monthly <= 0) {
      notes.unshift("Estimated Cool tier retrieval costs offset the estimated storage savings")
    }

    estimate['note'] = notes.join('. ')

    return estimate
  }

  result = []
  var total_savings = 0.0

  _.each(ds_storage_accounts_no_policy, function(account) {
    var estimate = estimateSavings(account)
    var savings = Math.max(estimate['net_savings'], 0)

    if (savings < param_min_savings) { return }

    // The payback period only applies to accounts that an estimate could be made for
    if (estimate['computed'] && param_max_payback_months > 0 && estimate['payback_months'] > param_max_payback_months) { return }

    total_savings += savings

    var tags = []

    if (typeof(account['tags']) == 'object') {
      _.each(_.keys(account['tags']), function(key) {
        tags.push([key, "=", account['tags'][key]].join(''))
      })
    }

    var recommendation_details = [
      "Create a lifecycle management policy for Azure Storage Account ", account['name'], " ",
      "in Azure Subscription ", account['subscriptionName'],
      " (", account['subscriptionId'], ") ",
      "that moves Hot block blobs to the Cool tier after ", param_cool_after_days, " days"
    ].join('')

    result.push({
      accountID: account['subscriptionId'],
      accountName: account['subscriptionName'],
      resourceGroup: account['resourceGroup'],
      resourceID: account['id'],
      resourceName: account['name'],
      region: account['region'],
      tags: tags.join(', '),
      recommendationDetails: recommendation_details,
      hotCapacityGB: round(estimate['hot_gb'], 3),
      eligibleCapacityGB: round(estimate['eligible_gb'], 3),
      coldFractionPct: round(estimate['cold_fraction_pct'], 2),
      transitionCostOneTime: round(estimate['transition_cost'], 3),
      paybackMonths: round(estimate['payback_months'], 2),
      savings: round(savings, 3),
      savingsCurrency: ds_currency['symbol'],
      savingsNote: estimate['note'],
      policy_name: ds_applied_policy['name'],
      service: "Microsoft.Storage",
      total_savings: "",
      message: ""
    })
  })

  // Message for incident output
  var total_accounts = ds_storage_accounts_no_policy.length
  var estimated_accounts = _.filter(result, function(item) { return item['savings'] > 0 }).length
  var estimated_percentage = total_accounts == 0 ? '0.00%' : (estimated_accounts / total_accounts * 100).toFixed(2).toString() + '%'

  var account_noun = total_accounts > 1 ? "Storage Accounts" : "Storage Account"
  var account_verb = estimated_accounts == 1 ? "is" : "are"

  var findings = [
    "Out of ", total_accounts, " Azure ", account_noun, " with blob tiering support and without a Lifecycle Management Policy, ",
    estimated_accounts, " (", estimated_percentage, ") ", account_verb,
    " estimated to save money by moving Hot block blobs to the Cool tier. "
  ].join('')

  var explanation = [
    "The Estimated Monthly Savings of each Storage Account is a conservative lower bound based on the last ",
    param_cool_after_days, " days of Azure Monitor metrics. ",
    "It assumes a Lifecycle Management rule that moves Hot block blobs to the Cool tier after ",
    param_cool_after_days, " days, and it is net of the estimated Cool tier data retrieval costs. ",
    "Only Hot block blob data that was neither written nor read during that time is counted, ",
    "and Cold and Archive tier savings are not estimated. "
  ].join('')

  if (param_max_payback_months > 0) {
    explanation += [
      "Storage Accounts that would take more than ", param_max_payback_months,
      " months of estimated savings to recover the one-time cost of moving their blobs to the Cool tier are not reported. "
    ].join('')
  }

  explanation += "See the Savings Note of each Storage Account for details on why an estimate could not be made.\n\n"

  var disclaimer = "The above settings can be modified by editing the applied policy and changing the appropriate parameters.\n\n"

  var savings_message = [ ds_currency['symbol'], formatNumber(total_savings, ds_currency['separator']) ].join(' ')

  // Sort by descending order of savings value
  result = _.sortBy(_.sortBy(result, 'resourceName'), function(item) { return -item['savings'] })

  // Dummy item to ensure that the check statement in the policy executes at least once
  result.push({
    accountID: "",
    accountName: "",
    resourceGroup: "",
    resourceID: "",
    resourceName: "",
    region: "",
    tags: "",
    recommendationDetails: "",
    hotCapacityGB: "",
    eligibleCapacityGB: "",
    coldFractionPct: "",
    transitionCostOneTime: "",
    paybackMonths: "",
    savings: "",
    savingsCurrency: "",
    savingsNote: "",
    policy_name: "",
    service: "",
    total_savings: "",
    message: ""
  })

  result[0]['total_savings'] = savings_message
  result[0]['message'] = findings + explanation + disclaimer + csv_message
  result[0]['policy_name'] = ds_applied_policy['name']
EOS
end

###############################################################################
# Policy
###############################################################################

policy "pol_azure_storage_account_lifecycle" do
  validate_each $ds_merged_metrics do
    summary_template "{{ with index data 0 }}{{ .policy_name }}{{ end }}: {{ len data }} Azure Storage Accounts Without Lifecycle Management Policies Found"
    detail_template <<-'EOS'
    **Potential Monthly Savings:** {{ with index data 0 }}{{ .total_savings }}{{ end }}

    {{ with index data 0 }}{{ .message }}{{ end }}
    EOS
    # Policy check fails and incident is created only if data is not empty and the Parent Policy has not been terminated
    check logic_or($ds_parent_policy_terminated, eq(val(item, "resourceID"), ""))
    escalate $esc_email
    hash_exclude "tags", "savings", "savingsCurrency", "hotCapacityGB", "eligibleCapacityGB", "coldFractionPct", "transitionCostOneTime", "paybackMonths", "savingsNote"
    export do
      resource_level true
      field "accountID" do
        label "Subscription ID"
      end
      field "accountName" do
        label "Subscription Name"
      end
      field "resourceGroup" do
        label "Resource Group"
      end
      field "resourceName" do
        label "Name"
      end
      field "tags" do
        label "Tags"
      end
      field "recommendationDetails" do
        label "Recommendation"
      end
      field "region" do
        label "Region"
      end
      field "hotCapacityGB" do
        label "Hot Capacity (GB)"
      end
      field "eligibleCapacityGB" do
        label "Eligible Capacity (GB)"
      end
      field "coldFractionPct" do
        label "Estimated Cold Fraction (%)"
      end
      field "transitionCostOneTime" do
        label "Transition Cost (One-Time)"
      end
      field "paybackMonths" do
        label "Payback Period (Months)"
      end
      field "savings" do
        label "Estimated Monthly Savings"
      end
      field "savingsCurrency" do
        label "Savings Currency"
      end
      field "savingsNote" do
        label "Savings Note"
      end
      field "service" do
        label "Service"
      end
      field "resourceID" do
        label "Resource ID"
      end
      field "id" do
        label "ID"
        path "resourceID"
      end
    end
  end
  validate $ds_no_subscriptions_error do
    summary_template "{{ with index data 0 }}{{ .policy_name }}{{ end }}: {{ len data }} Errors Identified"
    detail_template <<-'EOS'
    The policy was unable to access any Azure Subscriptions.

    **Error Details:**
    {{ range data -}}
      - {{ .error }}
    {{ end -}}

    **Recommended Actions:**
    1. Verify that the Azure credential has the required permissions to list subscriptions.
    2. Ensure the credential has not expired or been revoked.
    EOS
    check eq(size(data), 0)
    escalate $esc_email_errors_identified
  end
end

###############################################################################
# Escalations
###############################################################################

escalation "esc_email_errors_identified" do
  automatic true
  label "Send Email"
  description "Send incident email"
  email $param_email
end

escalation "esc_email" do
  automatic true
  label "Send Email"
  description "Send incident email"
  email $param_email do
    attach_export_table $param_incident_csv
    body_table_max_rows $param_incident_table_size
  end
end

###############################################################################
# Meta Policy [alpha]
# Not intended to be modified or used by policy developers
###############################################################################

# If the meta_parent_policy_id is not set it will evaluate to an empty string and we will look for the policy itself,
# if it is set we will look for the parent policy.
datasource "ds_get_parent_policy" do
  request do
    auth $auth_flexera
    host val($ds_flexera_api_hosts, "flexera")
    path join(["/policy/v1/orgs/", rs_org_id, "/projects/", rs_project_id, "/applied-policies/", switch(ne(meta_parent_policy_id, ""), meta_parent_policy_id, policy_id) ])
    ignore_status [404]
  end
  result do
    encoding "json"
    field "id", jmes_path(response, "id")
  end
end

# If the policy was applied by a meta_parent_policy we confirm it exists if it doesn't we confirm we are deleting
# This information is used in two places:
# - determining whether or not we make a delete call
# - determining if we should create an incident (we don't want to create an incident on the run where we terminate)
datasource "ds_parent_policy_terminated" do
  run_script $js_parent_policy_terminated, $ds_get_parent_policy, meta_parent_policy_id
end

script "js_parent_policy_terminated", type: "javascript" do
  parameters "ds_get_parent_policy", "meta_parent_policy_id"
  result "result"
  code <<-'EOS'
  result = meta_parent_policy_id != "" && ds_get_parent_policy["id"] == undefined
EOS
end

# Two potentials ways to set this up:
# - this way and make a unneeded 'get' request when not deleting
# - make the delete request an interate and have it iterate over an empty array when not deleting and an array with one item when deleting
datasource "ds_terminate_self" do
  request do
    run_script $js_make_terminate_request, $ds_parent_policy_terminated, $ds_flexera_api_hosts, policy_id, rs_org_id, rs_project_id
  end
end

script "js_make_terminate_request", type: "javascript" do
  parameters "ds_parent_policy_terminated", "ds_flexera_api_hosts", "policy_id", "rs_org_id", "rs_project_id"
  result "request"
  code <<-'EOS'
  var request = {
    auth: "auth_flexera",
    host: ds_flexera_api_hosts["flexera"],
    path: [ "/policy/v1/orgs/", rs_org_id, "/projects/", rs_project_id, "/applied-policies", policy_id ? "/"+policy_id : "" ].join(''),
    verb: ds_parent_policy_terminated ? "DELETE" : "GET"
  }
EOS
end

# This is just a way to have the check delete request connect to the farthest leaf from policy.
# We want the delete check to the first thing the policy does to avoid the policy erroring before it can decide whether or not it needs to self terminate
# Example a customer deletes a credential and then terminates the parent policy. We still want the children to self terminate
# The only way I could see this not happening is if the user who applied the parent_meta_policy was offboarded or lost policy access, the policies who are impersonating the user
# would not have access to self-terminate
# It may be useful for the backend to enable a mass terminate at some point for all meta_child_policies associated with an id.
datasource "ds_is_deleted" do
  run_script $js_is_deleted, $ds_terminate_self
end

script "js_is_deleted", type: "javascript" do
  parameters "ds_terminate_self"
  result "result"
  code 'result = { path: "/"}'
end
