  result "result"
  code <<-'EOS'
  var eligible_accounts = _.filter(ds_storage_accounts_no_policy, function(account) {
    return account['estimateEligible'] === true
  })

  result = _.compact(_.uniq(_.map(eligible_accounts, function(account) {
    return typeof(account['region']) == 'string' ? account['region'].toLowerCase() : ''
