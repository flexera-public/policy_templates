name "Azure Sentinel Commitment Tier Recommendations"
rs_pt_ver 20180301
type "policy"
short_description "Identifies Azure Log Analytics workspaces with Microsoft Sentinel enabled where purchasing, changing, or removing a daily ingestion Commitment Tier would reduce costs compared to the current pricing tier. Only workspaces on Microsoft Sentinel simplified pricing are evaluated. See the [README](https://github.com/flexera-public/policy_templates/tree/master/cost/azure/sentinel_commitment_tiers) and [docs.flexera.com/flexera/EN/Automation](https://docs.flexera.com/flexera-one/automation/) to learn more."
long_description ""
doc_link "https://github.com/flexera-public/policy_templates/tree/master/cost/azure/sentinel_commitment_tiers"
severity "medium"
category "Cost"
default_frequency "weekly"
info(
  version: "1.0.0",
  provider: "Azure",
  service: "Sentinel",
  policy_set: "Commitment Tiers",
  recommendation_type: "Rate Reduction",
  hide_skip_approvals: "true"
)

###############################################################################
# Parameters
###############################################################################

parameter "param_email" do
  type "list"
  category "Policy Settings"
  label "Email Addresses"
  description "A list of email addresses to notify."
  default []
end

parameter "param_azure_endpoint" do
  type "string"
  category "Policy Settings"
  label "Azure Endpoint"
  description "Select the API endpoint to use for Azure. Use default value of management.azure.com unless using Azure China."
  allowed_values "management.azure.com", "management.chinacloudapi.cn"
  default "management.azure.com"
end

parameter "param_min_savings" do
  type "number"
  category "Policy Settings"
  label "Minimum Savings Threshold"
  description "Minimum potential monthly savings required to generate a recommendation."
  min_value 0
  default 0
end

parameter "param_lookback_days" do
  type "number"
  category "Statistics"
  label "Statistic Lookback Period"
  description "How many complete days (UTC) back to look at Log Analytics ingestion data when calculating daily ingestion volumes. The current partial day is not included."
  min_value 7
  max_value 90
  default 30
end

parameter "param_subscriptions_allow_or_deny" do
  type "string"
  category "Filters"
  label "Allow/Deny Subscriptions"
  description "Allow or Deny entered subscriptions. See the README for more details."
  allowed_values "Allow", "Deny"
  default "Allow"
end

parameter "param_subscriptions_list" do
  type "list"
  category "Filters"
  label "Allow/Deny Subscriptions List"
  description "A list of allowed or denied subscription IDs/names. See the README for more details."
  default []
end

parameter "param_resource_groups_allow_or_deny" do
  type "string"
  category "Filters"
  label "Allow/Deny Resource Groups"
  description "Allow or Deny entered Resource Groups. See the README for more details."
  allowed_values "Allow", "Deny"
  default "Allow"
end

parameter "param_resource_groups_list" do
  type "list"
  category "Filters"
  label "Allow/Deny Resource Groups List"
  description "A list of allowed or denied Resource Group names to filter the results by. Optionally, entries can use the format SUBSCRIPTION_ID/RESOURCE_GROUP_NAME to limit filtering to a specific subscription. See the README for more details."
  default []
end

parameter "param_incident_csv" do
  type "string"
  category "Incident Settings"
  label "Attach CSV To Incident Email"
  description "Whether or not to attach the results as a CSV file to the incident email."
  allowed_values "true", "false"
  default "false"
end

parameter "param_incident_table_size" do
  type "number"
  category "Incident Settings"
  label "Incident Table Rows for Email Body (#)"
  description "The number of results to include in the incident table in the incident email. Set to '0' to not show an incident table at all, and '100000' to include all results. Does not impact attached CSV files or the incident as presented in Flexera One."
  allowed_values 0, 10, 50, 100, 200, 500, 1000, 10000, 100000
  default 100000
end

###############################################################################
# Authentication
###############################################################################

credentials "auth_azure" do
  schemes "oauth2"
  label "Azure"
  description "Select the Azure Resource Manager Credential from the list."
  tags "provider=azure_rm"
end

credentials "auth_flexera" do
  schemes "oauth2"
  label "Flexera"
  description "Select Flexera One OAuth2 credentials"
  tags "provider=flexera"
end

###############################################################################
# Pagination
###############################################################################

pagination "pagination_azure" do
  get_page_marker do
    body_path "nextLink"
  end
  set_page_marker do
    uri true
  end
end

pagination "pagination_azure_pricing" do
  get_page_marker do
    body_path "NextPageLink"
  end
  set_page_marker do
    uri true
  end
end

###############################################################################
# Datasources & Scripts
###############################################################################

datasource "ds_flexera_api_hosts" do
  run_script $js_flexera_api_hosts, rs_optima_host
end

script "js_flexera_api_hosts", type: "javascript" do
  parameters "rs_optima_host"
  result "result"
  code <<-'EOS'
    host_table = {
      "api.optima.flexeraeng.com": {
        flexera: "api.flexera.com",
        fsm: "api.fsm.flexeraeng.com",
        grs: "governance.rightscale.com",
        optima: "api.optima.flexeraeng.com",
        api: "api.flexera.com",
        ui: "app.flexera.com",
        tld: "flexera.com"
      },
      "api.optima-eu.flexeraeng.com": {
        flexera: "api.flexera.eu",
        fsm: "api.fsm-eu.flexeraeng.com",
        grs: "governance.rightscale.com",
        optima: "api.optima-eu.flexeraeng.com",
        api: "api.flexera.eu",
        ui: "app.flexera.eu",
        tld: "flexera.eu"
      },
      "api.optima-apac.flexeraeng.com": {
        flexera: "api.flexera.au",
        fsm: "api.fsm-apac.flexeraeng.com",
        grs: "governance.rightscale.com",
        optima: "api.optima-apac.flexeraeng.com",
        api: "api.flexera.au",
        ui: "app.flexera.au",
        tld: "flexera.au"
      }
    }
    result = host_table[rs_optima_host]
EOS
end

datasource "ds_applied_policy" do
  request do
    auth $auth_flexera
    host val($ds_flexera_api_hosts, "flexera")
    path join(["/policy/v1/orgs/", rs_org_id, "/projects/", rs_project_id, "/applied-policies", switch(policy_id, join(["/", policy_id]), "")])
  end
  result do
    encoding "json"
    field "id", jmes_path(response, "id")
    field "name", jmes_path(response, "name")
  end
end

datasource "ds_currency_reference" do
  request do
    host "raw.githubusercontent.com"
    path "/flexera-public/policy_templates/master/data/currency/currency_reference.json"
    header "User-Agent", "RS Policies"
  end
end

datasource "ds_currency_code" do
  request do
    auth $auth_flexera
    host rs_optima_host
    path join(["/bill-analysis/orgs/", rs_org_id, "/settings/currency_code"])
    header "Api-Version", "0.1"
    header "User-Agent", "RS Policies"
    ignore_status [403]
  end
  result do
    encoding "json"
    field "id", jmes_path(response, "id")
    field "value", jmes_path(response, "value")
  end
end

datasource "ds_currency_target" do
  run_script $js_currency_target, $ds_currency_reference, $ds_currency_code
end

script "js_currency_target", type: "javascript" do
  parameters "ds_currency_reference", "ds_currency_code"
  result "result"
  code <<-'EOS'
  // Default to USD if currency is not found
  result = ds_currency_reference['USD']

  if (ds_currency_code['value'] != undefined && ds_currency_reference[ds_currency_code['value']] != undefined) {
    result = ds_currency_reference[ds_currency_code['value']]
  }
EOS
end

datasource "ds_conditional_currency_conversion" do
  run_script $js_conditional_currency_conversion, $ds_currency_target
end

script "js_conditional_currency_conversion", type: "javascript" do
  parameters "ds_currency_target"
  result "result"
  code <<-'EOS'
  result = []
  // Prices from Azure Retail Prices API are always in USD; convert only if org currency differs
  if (ds_currency_target['code'] != 'USD') {
    result = [{ from: 'USD' }]
  }
EOS
end

datasource "ds_currency_conversion" do
  iterate $ds_conditional_currency_conversion
  request do
    host "api.xe-auth.flexeraeng.com"
    path "/prod/{proxy+}"
    query "from", val(iter_item, "from")
    query "to", val($ds_currency_target, "code")
    query "amount", "1"
    header "User-Agent", "RS Policies"
    ignore_status [400, 404, 502]
  end
  result do
    encoding "json"
    field "from", jmes_path(response, "from")
    field "to", jmes_path(response, "to")
    field "amount", jmes_path(response, "amount")
    field "year", jmes_path(response, "year")
  end
end

datasource "ds_currency" do
  run_script $js_currency, $ds_currency_target, $ds_currency_conversion
end

script "js_currency", type: "javascript" do
  parameters "ds_currency_target", "ds_currency_conversion"
  result "result"
  code <<-'EOS'
  result = ds_currency_target
  result['exchange_rate'] = 1

  if (ds_currency_conversion.length > 0) {
    currency_code = ds_currency_target['code']
    current_month = parseInt(new Date().toISOString().split('-')[1])

    conversion_block = _.find(ds_currency_conversion[0]['to'][currency_code], function(item) {
      return item['month'] == current_month
    })

    if (conversion_block != undefined) {
      result['exchange_rate'] = conversion_block['monthlyAverage']
    }
  }
EOS
end

datasource "ds_azure_subscriptions" do
  request do
    auth $auth_azure
    pagination $pagination_azure
    host $param_azure_endpoint
    path "/subscriptions/"
    query "api-version", "2022-12-01"
    header "User-Agent", "RS Policies"
    header "Meta-Flexera", val($ds_is_deleted, "path")
    ignore_status [400, 403, 404]
  end
  result do
    encoding "json"
    collect jmes_path(response, "value[*]") do
      field "id", jmes_path(col_item, "subscriptionId")
      field "name", jmes_path(col_item, "displayName")
      field "state", jmes_path(col_item, "state")
    end
  end
end

datasource "ds_azure_subscriptions_filtered" do
  run_script $js_azure_subscriptions_filtered, $ds_azure_subscriptions, $param_subscriptions_allow_or_deny, $param_subscriptions_list
end

script "js_azure_subscriptions_filtered", type: "javascript" do
  parameters "ds_azure_subscriptions", "param_subscriptions_allow_or_deny", "param_subscriptions_list"
  result "result"
  code <<-'EOS'
    var enabled_subscriptions = _.filter(ds_azure_subscriptions, function(sub) {
      return sub["state"] === "Enabled"
    })

    if (param_subscriptions_list.length > 0) {
      result = _.filter(enabled_subscriptions, function(subscription) {
        include_subscription = _.contains(param_subscriptions_list, subscription["id"]) ||
                               _.contains(param_subscriptions_list, subscription["name"])
        if (param_subscriptions_allow_or_deny == "Deny") {
          include_subscription = !include_subscription
        }
        return include_subscription
      })
    } else {
      result = enabled_subscriptions
    }
EOS
end

datasource "ds_no_subscriptions_error" do
  run_script $js_no_subscriptions_error, $ds_azure_subscriptions, $ds_applied_policy
end

script "js_no_subscriptions_error", type: "javascript" do
  parameters "ds_azure_subscriptions", "ds_applied_policy"
  result "result"
  code <<-'EOS'
  result = []

  if (ds_azure_subscriptions.length == 0) {
    result = [{
      policy_name: ds_applied_policy['name'],
      error: "No Azure Subscriptions found. This is usually caused by a lack of permissions or an expired/invalid credential."
    }]
  }
EOS
end

datasource "ds_log_analytics_workspaces" do
  iterate $ds_azure_subscriptions_filtered
  request do
    auth $auth_azure
    pagination $pagination_azure
    host $param_azure_endpoint
    path join(["/subscriptions/", val(iter_item, "id"), "/providers/Microsoft.OperationalInsights/workspaces"])
    query "api-version", "2023-09-01"
    header "User-Agent", "RS Policies"
    ignore_status [400, 403, 404]
  end
  result do
    encoding "json"
    collect jmes_path(response, "value[*]") do
      field "id", jmes_path(col_item, "id")
      field "name", jmes_path(col_item, "name")
      field "location", jmes_path(col_item, "location")
      field "resourceGroup", jmes_path(col_item, "id")
      field "workspaceId", jmes_path(col_item, "properties.customerId")
      field "sku", jmes_path(col_item, "properties.sku.name")
      field "capacityReservationLevel", jmes_path(col_item, "properties.sku.capacityReservationLevel")
      field "clusterResourceId", jmes_path(col_item, "properties.features.clusterResourceId")
      field "retentionInDays", jmes_path(col_item, "properties.retentionInDays")
      field "tags", jmes_path(col_item, "tags")
      field "subscriptionId", val(iter_item, "id")
      field "subscriptionName", val(iter_item, "name")
    end
  end
end

datasource "ds_log_analytics_workspaces_normalized" do
  run_script $js_log_analytics_workspaces_normalized, $ds_log_analytics_workspaces
end

script "js_log_analytics_workspaces_normalized", type: "javascript" do
  parameters "ds_log_analytics_workspaces"
  result "result"
  code <<-'EOS'
    result = _.map(ds_log_analytics_workspaces, function(ws) {
      var parts = ws["id"].split("/")
      var rg = ""
      for (var i = 0; i < parts.length; i++) {
        if (parts[i].toLowerCase() === "resourcegroups" && i + 1 < parts.length) {
          rg = parts[i + 1]
          break
        }
      }
      return {
        id: ws["id"],
        name: ws["name"],
        location: ws["location"],
        resourceGroup: rg,
        workspaceId: ws["workspaceId"],
        sku: ws["sku"],
        capacityReservationLevel: ws["capacityReservationLevel"] || 0,
        clusterResourceId: ws["clusterResourceId"],
        retentionInDays: ws["retentionInDays"],
        tags: ws["tags"],
        subscriptionId: ws["subscriptionId"],
        subscriptionName: ws["subscriptionName"]
      }
    })
EOS
end

datasource "ds_log_analytics_workspaces_supported" do
  run_script $js_log_analytics_workspaces_supported, $ds_log_analytics_workspaces_normalized
end

script "js_log_analytics_workspaces_supported", type: "javascript" do
  parameters "ds_log_analytics_workspaces_normalized"
  result "result"
  code <<-'EOS'
    // Workspaces linked to a dedicated cluster bill through the cluster's commitment, and legacy
    // workspace SKUs are free or billed per node. This policy cannot model either, so skip them.
    var unsupported_skus = ["lacluster", "free", "standalone", "pernode", "standard", "premium"]

    result = _.filter(ds_log_analytics_workspaces_normalized, function(ws) {
      var sku = (ws["sku"] || "").toLowerCase().trim()
      var cluster_resource_id = (ws["clusterResourceId"] || "").trim()
      return !_.contains(unsupported_skus, sku) && cluster_resource_id === ""
    })
EOS
end

datasource "ds_sentinel_onboarding" do
  iterate $ds_log_analytics_workspaces_supported
  request do
    auth $auth_azure
    host $param_azure_endpoint
    path join([ "/subscriptions/", val(iter_item, "subscriptionId"), "/resourceGroups/", val(iter_item, "resourceGroup"), "/providers/Microsoft.OperationalInsights/workspaces/", val(iter_item, "name"), "/providers/Microsoft.SecurityInsights/onboardingStates/default" ])
    query "api-version", "2023-02-01"
    header "User-Agent", "RS Policies"
    ignore_status [400, 403, 404]
  end
  result do
    encoding "json"
    field "workspaceId", val(iter_item, "workspaceId")
    field "onboardingStateId", jmes_path(response, "id")
  end
end

datasource "ds_sentinel_workspaces" do
  run_script $js_sentinel_workspaces, $ds_log_analytics_workspaces_supported, $ds_sentinel_onboarding
end

script "js_sentinel_workspaces", type: "javascript" do
  parameters "ds_log_analytics_workspaces_supported", "ds_sentinel_onboarding"
  result "result"
  code <<-'EOS'
    var onboarding_map = {}
    _.each(ds_sentinel_onboarding, function(item) {
      if (item["onboardingStateId"] != undefined && item["onboardingStateId"] != null && item["onboardingStateId"] != "") {
        onboarding_map[item["workspaceId"]] = item["onboardingStateId"]
      }
    })
    result = _.filter(ds_log_analytics_workspaces_supported, function(ws) {
      return onboarding_map[ws["workspaceId"]] != undefined
    })
EOS
end

datasource "ds_sentinel_pricing_scheme" do
  iterate $ds_sentinel_workspaces
  request do
    auth $auth_azure
    host $param_azure_endpoint
    path join(["/subscriptions/", val(iter_item, "subscriptionId"), "/resourceGroups/", val(iter_item, "resourceGroup"), "/providers/Microsoft.OperationsManagement/solutions/SecurityInsights(", val(iter_item, "name"), ")"])
    query "api-version", "2015-11-01-preview"
    header "User-Agent", "RS Policies"
    ignore_status [400, 403, 404]
  end
  result do
    encoding "json"
    field "workspaceId", val(iter_item, "workspaceId")
    field "skuName", jmes_path(response, "properties.sku.name")
    field "capacityReservationLevel", jmes_path(response, "properties.sku.capacityReservationLevel")
    field "topLevelCapacityReservationLevel", jmes_path(response, "sku.capacityReservationLevel")
  end
end

datasource "ds_sentinel_workspaces_with_scheme" do
  run_script $js_sentinel_workspaces_with_scheme, $ds_sentinel_workspaces, $ds_sentinel_pricing_scheme
end

script "js_sentinel_workspaces_with_scheme", type: "javascript" do
  parameters "ds_sentinel_workspaces", "ds_sentinel_pricing_scheme"
  result "result"
  code <<-'EOS'
    function toTierGB(value) {
      var level = parseInt(value, 10)
      return isNaN(level) || level < 0 ? 0 : level
    }

    var solution_map = {}
    _.each(ds_sentinel_pricing_scheme, function(item) {
      if (item["workspaceId"] && item["skuName"] != null && item["skuName"] != undefined) {
        solution_map[item["workspaceId"]] = item
      }
    })

    result = []
    _.each(ds_sentinel_workspaces, function(ws) {
      var solution = solution_map[ws["workspaceId"]]

      // Only simplified pricing (solution sku name "Unified") is evaluated. Everything else is dropped
      // here, before any ingestion query is run for it.
      if (!solution || String(solution["skuName"]).toLowerCase().trim() !== "unified") { return }

      // The current commitment tier is the capacityReservationLevel on the Sentinel solution. A missing
      // or 0 level means Pay-As-You-Go.
      var tier_gb = toTierGB(solution["capacityReservationLevel"]) || toTierGB(solution["topLevelCapacityReservationLevel"])

      // Microsoft's simplified pricing ARM sample sets the level on the workspace (sku capacityreservation)
      // and only sku name Unified on the solution. If the solution reports no level, use the workspace's
      // level instead of misreading a committed workspace as Pay-As-You-Go, which would overstate savings.
      if (tier_gb === 0 && String(ws["sku"] || "").toLowerCase().trim() === "capacityreservation") {
        tier_gb = toTierGB(ws["capacityReservationLevel"])
      }

      var new_ws = {}
      _.each(ws, function(v, k) { new_ws[k] = v })
      new_ws["currentTierGB"] = tier_gb
      result.push(new_ws)
    })
EOS
end

datasource "ds_workspace_ingestion_raw" do
  iterate $ds_sentinel_workspaces_with_scheme
  request do
    run_script $js_workspace_ingestion_raw, iter_item, $param_lookback_days, $param_azure_endpoint
  end
  result do
    encoding "json"
    field "workspaceId", val(iter_item, "workspaceId")
    field "workspaceName", val(iter_item, "name")
    field "subscriptionId", val(iter_item, "subscriptionId")
    field "subscriptionName", val(iter_item, "subscriptionName")
    field "resourceGroup", val(iter_item, "resourceGroup")
    field "location", val(iter_item, "location")
    field "currentTierGB", val(iter_item, "currentTierGB")
    field "tags", val(iter_item, "tags")
    field "resourceID", val(iter_item, "id")
    field "columns", jmes_path(response, "tables[0].columns")
    field "rows", jmes_path(response, "tables[0].rows")
  end
end

script "js_workspace_ingestion_raw", type: "javascript" do
  parameters "workspace", "param_lookback_days", "param_azure_endpoint"
  result "request"
  code <<-'EOS'
    var lookback_days = parseInt(param_lookback_days, 10)

    // Only complete UTC days are counted (no partial first day or partial "today" bin), and only
    // Analytics plan data, since commitment tiers do not cover Basic or Auxiliary ingestion. Rows
    // written before the Plan column existed have it empty, so empty is treated as Analytics.
    var query = [
      "Usage",
      "| where TimeGenerated > ago(" + (lookback_days + 1) + "d)",
      "| where StartTime >= startofday(ago(" + lookback_days + "d)) and EndTime < startofday(now())",
      "| where IsBillable == true",
      '| where Plan == "Analytics" or isempty(Plan)',
      "| summarize DataGB = sum(Quantity) / 1000. by bin(StartTime, 1d)",
      "| order by StartTime asc"
    ].join("\n")

    request = {
      auth: "auth_azure",
      verb: "POST",
      host: param_azure_endpoint,
      path: "/subscriptions/" + workspace["subscriptionId"] + "/resourceGroups/" + workspace["resourceGroup"] + "/providers/microsoft.operationalinsights/workspaces/" + workspace["name"] + "/query",
      query_params: { "api-version": "2017-10-01" },
      headers: { "User-Agent": "RS Policies", "Content-Type": "application/json" },
      body_fields: { "query": query },
      ignore_status: [400, 403, 404]
    }
EOS
end

datasource "ds_workspace_ingestion" do
  run_script $js_workspace_ingestion, $ds_workspace_ingestion_raw
end

script "js_workspace_ingestion", type: "javascript" do
  parameters "ds_workspace_ingestion_raw"
  result "result"
  code <<-'EOS'
    var ms_per_day = 86400000

    result = []

    _.each(ds_workspace_ingestion_raw, function(ws) {
      var columns = ws["columns"] || []
      var rows = ws["rows"] || []

      var col_index = {}
      _.each(columns, function(col, idx) {
        col_index[col["name"]] = idx
      })

      var start_time_idx = col_index["StartTime"]
      var data_gb_idx = col_index["DataGB"]

      // Billable GB per UTC day, keyed by whole days since the Unix epoch
      var gb_by_day = {}
      var first_day = null
      var last_day = null

      if (start_time_idx != undefined && data_gb_idx != undefined) {
        _.each(rows, function(row) {
          var gb = row[data_gb_idx]
          var date_parts = String(row[start_time_idx]).substring(0, 10).split("-")
          var day = Math.round(Date.UTC(parseInt(date_parts[0], 10), parseInt(date_parts[1], 10) - 1, parseInt(date_parts[2], 10)) / ms_per_day)

          if (gb != null && !isNaN(gb) && !isNaN(day)) {
            gb_by_day[day] = (gb_by_day[day] || 0) + parseFloat(gb)
            if (first_day === null || day < first_day) { first_day = day }
            if (last_day === null || day > last_day) { last_day = day }
          }
        })
      }

      // A commitment tier still bills on days with no ingestion, so days missing between the first
      // and last returned day count as 0 GB.
      var daily_gb_values = []
      if (first_day !== null) {
        for (var d = first_day; d <= last_day; d++) {
          daily_gb_values.push(gb_by_day[d] || 0)
        }
      }

      var avg_daily_gb = 0
      var peak_daily_gb = 0
      var total_gb = 0

      if (daily_gb_values.length > 0) {
        total_gb = _.reduce(daily_gb_values, function(sum, x) { return sum + x }, 0)
        avg_daily_gb = total_gb / daily_gb_values.length
        peak_daily_gb = _.max(daily_gb_values)
      }

      result.push({
        workspaceId: ws["workspaceId"],
        workspaceName: ws["workspaceName"],
        subscriptionId: ws["subscriptionId"],
        subscriptionName: ws["subscriptionName"],
        resourceGroup: ws["resourceGroup"],
        location: ws["location"],
        currentTierGB: ws["currentTierGB"],
        tags: ws["tags"],
        resourceID: ws["resourceID"],
        dailyGB: daily_gb_values,
        avgDailyGB: avg_daily_gb,
        peakDailyGB: peak_daily_gb,
        totalGB: total_gb,
        daysObserved: daily_gb_values.length
      })
    })
EOS
end

datasource "ds_workspace_ingestion_rg_filtered" do
  run_script $js_workspace_ingestion_rg_filtered, $ds_workspace_ingestion, $param_resource_groups_allow_or_deny, $param_resource_groups_list
end

script "js_workspace_ingestion_rg_filtered", type: "javascript" do
  parameters "ds_workspace_ingestion", "param_resource_groups_allow_or_deny", "param_resource_groups_list"
  result "result"
  code <<-'EOS'
    if (param_resource_groups_list.length > 0) {
      result = _.filter(ds_workspace_ingestion, function(resource) {
        rg = resource['resourceGroup']
        sub = resource['subscriptionId'] || resource['subscriptionID']
        include_resource = _.any(param_resource_groups_list, function(rg_entry) {
          if (rg_entry.indexOf('/') != -1) {
            entry_parts = rg_entry.split('/')
            return sub == entry_parts[0] && rg == entry_parts[1]
          }
          return rg == rg_entry
        })
        if (param_resource_groups_allow_or_deny == "Deny") {
          include_resource = !include_resource
        }
        return include_resource
      })
    } else {
      result = ds_workspace_ingestion
    }
EOS
end

datasource "ds_pricing_regions" do
  run_script $js_pricing_regions, $ds_workspace_ingestion_rg_filtered
end

script "js_pricing_regions", type: "javascript" do
  parameters "ds_workspace_ingestion_rg_filtered"
  result "result"
  code <<-'EOS'
    var regions = _.uniq(_.pluck(ds_workspace_ingestion_rg_filtered, "location"))
    result = _.map(regions, function(r) { return { region: r } })
EOS
end

datasource "ds_pricing" do
  iterate $ds_pricing_regions
  request do
    pagination $pagination_azure_pricing
    host "prices.azure.com"
    path "/api/retail/prices"
    query "api-version", "2023-01-01-preview"
    query "$filter", join(["serviceName eq 'Sentinel' and armRegionName eq '", val(iter_item, "region"), "' and priceType eq 'Consumption'"])
    header "User-Agent", "RS Policies"
    ignore_status [400, 404]
  end
  result do
    encoding "json"
    collect jmes_path(response, "Items[*]") do
      field "region", val(iter_item, "region")
      field "skuName", jmes_path(col_item, "skuName")
      field "meterName", jmes_path(col_item, "meterName")
      field "productName", jmes_path(col_item, "productName")
      field "unitOfMeasure", jmes_path(col_item, "unitOfMeasure")
      field "retailPrice", jmes_path(col_item, "retailPrice")
      field "tierMinimumUnits", jmes_path(col_item, "tierMinimumUnits")
      field "unitPrice", jmes_path(col_item, "unitPrice")
      field "currencyCode", jmes_path(col_item, "currencyCode")
      field "serviceName", jmes_path(col_item, "serviceName")
    end
  end
end

datasource "ds_sentinel_incident" do
  run_script $js_sentinel_incident, $ds_workspace_ingestion_rg_filtered, $ds_pricing, $ds_currency, $ds_applied_policy, $param_lookback_days, $param_min_savings, $param_incident_csv
end

script "js_sentinel_incident", type: "javascript" do
  parameters "ds_workspace_ingestion_rg_filtered", "ds_pricing", "ds_currency", "ds_applied_policy", "param_lookback_days", "param_min_savings", "param_incident_csv"
  result "result"
  code <<-'EOS'
    function formatNumber(number, separator) {
      var formatted_number = "0"
      if (number) {
        formatted_number = (Math.round(number * 100) / 100).toString().split(".")[0]
        if (separator) {
          var withSeparator = ""
          for (var i = 0; i < formatted_number.length; i++) {
            if (i > 0 && (formatted_number.length - i) % 3 == 0) { withSeparator += separator }
            withSeparator += formatted_number[i]
          }
          formatted_number = withSeparator
        }
        var decimal = (Math.round(number * 100) / 100).toString().split(".")[1]
        if (decimal) { formatted_number += "." + decimal }
      }
      return formatted_number
    }

    // Each rate must come from one specific meter. Meters for Classic, Basic/Auxiliary logs, data lake,
    // and other non-Analytics products are rejected so a lookalike meter can never supply a rate.
    var rejected_meter_terms = ["classic", "basic", "auxiliary", "data lake", "lake", "retention", "restore", "search", "export", "graph", "free", "trial"]

    var pricing_by_region = {}
    _.each(ds_pricing, function(item) {
      var region = item["region"]
      var meter = (item["meterName"] || "").toLowerCase().trim()
      var unit = (item["unitOfMeasure"] || "").toLowerCase()
      var price = parseFloat(item["retailPrice"]) || 0
      var tier_min = parseFloat(item["tierMinimumUnits"]) || 0

      if (!pricing_by_region[region]) {
        pricing_by_region[region] = { meters: {}, payg_rate: 0, tier_rates: {}, tier_gbs: [], valid: false }
      }

      if (price <= 0 || meter === "") { return }

      var rejected = _.any(rejected_meter_terms, function(term) { return meter.indexOf(term) >= 0 })
      if (rejected) { return }

      var is_payg = meter === "pay-as-you-go analysis" && unit.indexOf("gb") >= 0
      var tier_gb = 0

      if (!is_payg && unit.indexOf("day") >= 0) {
        var gb_match = meter.match(/^(\d+)\s+gb\s+commitment\s+tier(\s+capacity\s+reservation)?$/)
        var tb_match = meter.match(/^(\d+)\s+tb\s+commitment\s+tier(\s+capacity\s+reservation)?$/)
        if (gb_match) { tier_gb = parseInt(gb_match[1], 10) }
        else if (tb_match) { tier_gb = parseInt(tb_match[1], 10) * 1000 }
      }

      if (!is_payg && tier_gb <= 0) { return }

      // One entry per meter. If several priced rows remain for a meter, the highest tierMinimumUnits wins.
      var existing = pricing_by_region[region]["meters"][meter]
      if (!existing || tier_min > existing["tier_min"]) {
        pricing_by_region[region]["meters"][meter] = { payg: is_payg, tier_gb: tier_gb, price: price, tier_min: tier_min }
      }
    })

    _.each(pricing_by_region, function(pricing) {
      var ambiguous = false

      _.each(pricing["meters"], function(entry) {
        if (entry["payg"]) {
          pricing["payg_rate"] = entry["price"]
        } else if (pricing["tier_rates"][entry["tier_gb"]]) {
          // Two different meters for the same tier size, so there is no single meter to trust
          ambiguous = true
        } else {
          pricing["tier_rates"][entry["tier_gb"]] = entry["price"]
        }
      })

      pricing["tier_gbs"] = _.sortBy(_.map(_.keys(pricing["tier_rates"]), function(t) { return parseInt(t, 10) }), function(t) { return t })

      // Pay-as-you-go must cost more per GB than every tier's effective rate (tier daily price / tier GB).
      // If not, the meters were mis-parsed and the region's workspaces are skipped.
      var payg_exceeds_tiers = _.every(pricing["tier_gbs"], function(tier_gb) {
        return pricing["payg_rate"] > pricing["tier_rates"][tier_gb] / tier_gb
      })

      pricing["valid"] = pricing["payg_rate"] > 0 && !ambiguous && payg_exceeds_tiers
    })

    function calculateDailyCost(daily_gb, tier_gb, tier_daily_rate, payg_rate) {
      if (tier_gb === 0) {
        return daily_gb * payg_rate
      }
      var overage = daily_gb > tier_gb ? (daily_gb - tier_gb) : 0
      var tier_per_gb_rate = tier_daily_rate / tier_gb
      return tier_daily_rate + overage * tier_per_gb_rate
    }

    // Commitment tiers bill every UTC day, and a day below the commitment still pays the full tier
    // price. The cost is therefore the mean of each day's cost, not the cost of the mean ingestion.
    function calculateMeanDailyCost(daily_values, tier_gb, tier_daily_rate, payg_rate) {
      var total_cost = 0
      _.each(daily_values, function(day_gb) {
        total_cost += calculateDailyCost(day_gb, tier_gb, tier_daily_rate, payg_rate)
      })
      return total_cost / daily_values.length
    }

    var min_complete_days = 7
    var result = []
    var total_savings = 0.0
    var exchange_rate = ds_currency["exchange_rate"]

    _.each(ds_workspace_ingestion_rg_filtered, function(ws) {
      var pricing = pricing_by_region[ws["location"]]
      var daily_gb_values = ws["dailyGB"] || []
      var avg_daily_gb = ws["avgDailyGB"] || 0

      if (!pricing || !pricing["valid"]) { return }
      if (daily_gb_values.length < min_complete_days || avg_daily_gb <= 0) { return }

      var payg_rate = pricing["payg_rate"] * exchange_rate
      var current_tier_gb = ws["currentTierGB"] || 0

      var current_tier_rate = 0
      if (current_tier_gb > 0) {
        current_tier_rate = (pricing["tier_rates"][current_tier_gb] || 0) * exchange_rate
        if (current_tier_rate <= 0) { return }
      }

      var current_daily_cost = calculateMeanDailyCost(daily_gb_values, current_tier_gb, current_tier_rate, payg_rate)

      var best_tier_gb = current_tier_gb
      var best_daily_cost = current_daily_cost

      // Evaluate all commitment tiers regardless of direction to surface both upgrades and downgrades
      _.each(pricing["tier_gbs"], function(tier_gb) {
        if (tier_gb !== current_tier_gb) {
          var tier_rate = pricing["tier_rates"][tier_gb] * exchange_rate
          var tier_cost = calculateMeanDailyCost(daily_gb_values, tier_gb, tier_rate, payg_rate)
          if (tier_cost < best_daily_cost) {
            best_tier_gb = tier_gb
            best_daily_cost = tier_cost
          }
        }
      })

      // If currently on a commitment tier, also check whether switching to PAYG would be cheaper
      if (current_tier_gb > 0) {
        var payg_daily_cost = calculateMeanDailyCost(daily_gb_values, 0, 0, payg_rate)
        if (payg_daily_cost < best_daily_cost) {
          best_tier_gb = 0
          best_daily_cost = payg_daily_cost
        }
      }

      if (best_tier_gb === current_tier_gb) { return }

      var monthly_savings = (current_daily_cost - best_daily_cost) * 30.44

      if (monthly_savings < param_min_savings) { return }

      total_savings += monthly_savings

      var current_monthly_cost = Math.round(current_daily_cost * 30.44 * 100) / 100
      var new_monthly_cost = Math.round(best_daily_cost * 30.44 * 100) / 100

      var current_tier_label = current_tier_gb === 0 ? "Pay-As-You-Go" : (current_tier_gb + " GB/day")
      var recommended_tier_label = best_tier_gb === 0 ? "Pay-As-You-Go" : (best_tier_gb + " GB/day")

      var action_verb, target_phrase
      if (best_tier_gb === 0) {
        action_verb = "Switch"
        target_phrase = "Pay-As-You-Go pricing"
      } else if (best_tier_gb > current_tier_gb) {
        action_verb = "Upgrade"
        target_phrase = "the " + best_tier_gb + " GB/day Commitment Tier"
      } else {
        action_verb = "Downgrade"
        target_phrase = "the " + best_tier_gb + " GB/day Commitment Tier"
      }

      var recommendation_details = action_verb + " Sentinel workspace '" + ws["workspaceName"] + "' from " + current_tier_label + " to " + target_phrase + ". Based on " + daily_gb_values.length + " complete days of ingestion (an average of " + (Math.round(avg_daily_gb * 100) / 100) + " GB/day), this change is estimated to save " + ds_currency["symbol"] + (Math.round(monthly_savings * 100) / 100) + " per month."

      if (best_tier_gb < current_tier_gb) {
        recommendation_details += " Commitment tiers can only be lowered 31 days after the last tier change."
      }

      var tags = []
      if (ws["tags"] && typeof(ws["tags"]) == "object") {
        _.each(ws["tags"], function(value, key) { tags.push(key + "=" + value) })
      }

      result.push({
        accountID: ws["subscriptionId"],
        accountName: ws["subscriptionName"],
        resourceID: ws["resourceID"],
        resourceName: ws["workspaceName"],
        tags: tags.join(", "),
        recommendationDetails: recommendation_details,
        region: ws["location"],
        resourceGroup: ws["resourceGroup"],
        currentTier: current_tier_label,
        recommendedTier: recommended_tier_label,
        avgDailyGB: Math.round(avg_daily_gb * 100) / 100,
        peakDailyGB: Math.round(ws["peakDailyGB"] * 100) / 100,
        daysObserved: ws["daysObserved"],
        currentMonthlyCost: current_monthly_cost,
        newMonthlyCost: new_monthly_cost,
        savings: parseFloat(monthly_savings.toFixed(3)),
        savingsCurrency: ds_currency["symbol"],
        lookbackPeriod: param_lookback_days,
        service: "Microsoft.SentinelPlatformServices",
        policy_name: ds_applied_policy["name"],
        total_savings: "",
        message: ""
      })
    })

    result = _.sortBy(result, function(item) { return item["savings"] * -1 })

    result.push({ policy_name: "", total_savings: "", message: "", savings: -1 })

    var savings_message = ds_currency["symbol"] + " " + formatNumber(parseFloat(total_savings).toFixed(2), ds_currency["t_separator"])

    var message = "The following settings were used when generating recommendations:\n" +
      "- Look Back Period: " + param_lookback_days + " days\n" +
      "- Minimum Savings Threshold: " + param_min_savings + "\n\n"

    var disclaimer = "The above settings can be modified by editing the applied policy and changing the appropriate parameters.\n\n"
    var empty_fields = "Empty fields indicate information that is not applicable to that particular recommendation.\n\n"
    var csv_message = param_incident_csv == "false" ? "" : "Incident table CSV file has been attached to emails for this incident."

    result[0]["total_savings"] = savings_message
    result[0]["message"] = message + disclaimer + empty_fields + csv_message
EOS
end

###############################################################################
# Policy
###############################################################################

policy "pol_sentinel_commitment_tier_recommendations" do
  validate_each $ds_sentinel_incident do
    summary_template "{{ with index data 0 }}{{ .policy_name }}{{ end }}: {{ len data }} Azure Sentinel Commitment Tier Recommendations"
    detail_template <<-'EOS'
    **Potential Monthly Savings:** {{ with index data 0 }}{{ .total_savings }}{{ end }}

    {{ with index data 0 }}{{ .message }}{{ end }}
    EOS
    check logic_or($ds_parent_policy_terminated, lt(val(item, "savings"), 0))
    escalate $esc_email
    hash_exclude "tags", "savings", "savingsCurrency"
    export do
      resource_level false
      field "accountID" do
        label "Subscription ID"
      end
      field "accountName" do
        label "Subscription Name"
      end
      field "resourceGroup" do
        label "Resource Group"
      end
      field "resourceID" do
        label "Resource ID"
      end
      field "resourceName" do
        label "Workspace Name"
      end
      field "tags" do
        label "Resource Tags"
      end
      field "recommendationDetails" do
        label "Recommendation"
      end
      field "region" do
        label "Region"
      end
      field "currentTier" do
        label "Current Pricing Tier"
      end
      field "recommendedTier" do
        label "Recommended Pricing Tier"
      end
      field "avgDailyGB" do
        label "Average Daily Ingestion (GB)"
      end
      field "peakDailyGB" do
        label "Peak Daily Ingestion (GB)"
      end
      field "daysObserved" do
        label "Days Observed"
      end
      field "currentMonthlyCost" do
        label "Current Estimated Monthly Cost"
      end
      field "newMonthlyCost" do
        label "New Estimated Monthly Cost"
      end
      field "savings" do
        label "Estimated Monthly Savings"
      end
      field "savingsCurrency" do
        label "Savings Currency"
      end
      field "lookbackPeriod" do
        label "Look Back Period (Days)"
      end
      field "service" do
        label "Service"
      end
      field "id" do
        label "ID"
        path "resourceID"
      end
    end
  end
  validate $ds_no_subscriptions_error do
    summary_template "{{ with index data 0 }}{{ .policy_name }}{{ end }}: {{ len data }} Errors Identified"
    detail_template <<-'EOS'
    The policy was unable to access any Azure Subscriptions.

    **Error Details:**
    {{ range data -}}
      - {{ .error }}
    {{ end -}}

    **Recommended Actions:**
    1. Verify that the Azure credential has the required permissions to list subscriptions.
    2. Ensure the credential has not expired or been revoked.
    EOS
    check eq(size(data), 0)
    escalate $esc_email_errors_identified
  end
end

###############################################################################
# Escalations
###############################################################################

escalation "esc_email_errors_identified" do
  automatic true
  label "Send Email"
  description "Send incident email"
  email $param_email
end

escalation "esc_email" do
  automatic true
  label "Send Email"
  description "Send incident email"
  email $param_email do
    attach_export_table $param_incident_csv
    body_table_max_rows $param_incident_table_size
  end
end

###############################################################################
# Meta Policy [alpha]
# Not intended to be modified or used by policy developers
###############################################################################

# If the meta_parent_policy_id is not set it will evaluate to an empty string and we will look for the policy itself,
# if it is set we will look for the parent policy.
datasource "ds_get_parent_policy" do
  request do
    auth $auth_flexera
    host val($ds_flexera_api_hosts, "flexera")
    path join(["/policy/v1/orgs/", rs_org_id, "/projects/", rs_project_id, "/applied-policies/", switch(ne(meta_parent_policy_id, ""), meta_parent_policy_id, policy_id) ])
    ignore_status [404]
  end
  result do
    encoding "json"
    field "id", jmes_path(response, "id")
  end
end

# If the policy was applied by a meta_parent_policy we confirm it exists if it doesn't we confirm we are deleting
# This information is used in two places:
# - determining whether or not we make a delete call
# - determining if we should create an incident (we don't want to create an incident on the run where we terminate)
datasource "ds_parent_policy_terminated" do
  run_script $js_parent_policy_terminated, $ds_get_parent_policy, meta_parent_policy_id
end

script "js_parent_policy_terminated", type: "javascript" do
  parameters "ds_get_parent_policy", "meta_parent_policy_id"
  result "result"
  code <<-'EOS'
  result = meta_parent_policy_id != "" && ds_get_parent_policy["id"] == undefined
EOS
end

# Two potentials ways to set this up:
# - this way and make a unneeded 'get' request when not deleting
# - make the delete request an interate and have it iterate over an empty array when not deleting and an array with one item when deleting
datasource "ds_terminate_self" do
  request do
    run_script $js_make_terminate_request, $ds_parent_policy_terminated, $ds_flexera_api_hosts, policy_id, rs_org_id, rs_project_id
  end
end

script "js_make_terminate_request", type: "javascript" do
  parameters "ds_parent_policy_terminated", "ds_flexera_api_hosts", "policy_id", "rs_org_id", "rs_project_id"
  result "request"
  code <<-'EOS'
  var request = {
    auth: "auth_flexera",
    host: ds_flexera_api_hosts["flexera"],
    path: [ "/policy/v1/orgs/", rs_org_id, "/projects/", rs_project_id, "/applied-policies", policy_id ? "/"+policy_id : "" ].join(''),
    verb: ds_parent_policy_terminated ? "DELETE" : "GET"
  }
EOS
end

# This is just a way to have the check delete request connect to the farthest leaf from policy.
# We want the delete check to the first thing the policy does to avoid the policy erroring before it can decide whether or not it needs to self terminate
# Example a customer deletes a credential and then terminates the parent policy. We still want the children to self terminate
# The only way I could see this not happening is if the user who applied the parent_meta_policy was offboarded or lost policy access, the policies who are impersonating the user
# would not have access to self-terminate
# It may be useful for the backend to enable a mass terminate at some point for all meta_child_policies associated with an id.
datasource "ds_is_deleted" do
  run_script $js_is_deleted, $ds_terminate_self
end

script "js_is_deleted", type: "javascript" do
  parameters "ds_terminate_self"
  result "result"
  code 'result = { path: "/"}'
end
